#!/usr/bin/env bash
# Codex CLI hook -> notipill, falling back to notify-send (mako)
# Reads hook JSON on stdin. Argv[1] is the event name.
set -u
event="${1:-unknown}"
payload="$(cat)"

cwd="$(printf '%s' "$payload" | jq -r '.cwd // ""' 2>/dev/null)"
project="${cwd##*/}"
project="${project:-codex}"

case "$event" in
  PermissionRequest)
    tool="$(printf '%s' "$payload" | jq -r '.tool_name // .tool // "tool"' 2>/dev/null)"
    if ! "$HOME/.local/bin/notipill" send --source codex --kind attention --title "Codex · $project" --body "permission: $tool" >/dev/null 2>&1; then
      notify-send -a Codex -u critical -i utilities-terminal "Codex • $project" "Permission requested: $tool" >/dev/null 2>&1
    fi
    ;;
  Stop)
    if ! "$HOME/.local/bin/notipill" send --source codex --kind done --title "Codex · $project" --body "turn finished" >/dev/null 2>&1; then
      notify-send -a Codex -u normal -i utilities-terminal "Codex done • $project" "Turn finished" >/dev/null 2>&1
    fi
    ;;
  *)
    if ! "$HOME/.local/bin/notipill" send --source codex --kind info --title "Codex · $project" --body "Unknown hook event: $event" >/dev/null 2>&1; then
      notify-send -a Codex -u low -i utilities-terminal "Codex" "Unknown hook event: $event" >/dev/null 2>&1
    fi
    ;;
esac

# Empty JSON object — no decision, no override
printf '{}'
