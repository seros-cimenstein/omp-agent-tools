#!/usr/bin/env bash
# Gemini CLI hook -> notipill, falling back to notify-send (mako)
# Reads hook JSON on stdin. Argv[1] is the event name.
# stdout MUST stay JSON-only per Gemini hook contract.
set -u
event="${1:-unknown}"
payload="$(cat)"

cwd="$(printf '%s' "$payload" | jq -r '.cwd // ""' 2>/dev/null)"
project="${cwd##*/}"
project="${project:-gemini}"

case "$event" in
  Notification)
    msg="$(printf '%s' "$payload" | jq -r '.message // "Gemini needs your attention"' 2>/dev/null)"
    if ! "$HOME/.local/bin/notipill" send --source gemini --kind attention --title "Gemini · $project" --body "$msg" >/dev/null 2>&1; then
      notify-send -a Gemini -u critical -i utilities-terminal "Gemini • $project" "$msg" >/dev/null 2>&1
    fi
    ;;
  AfterAgent)
    if ! "$HOME/.local/bin/notipill" send --source gemini --kind done --title "Gemini · $project" --body "turn finished" >/dev/null 2>&1; then
      notify-send -a Gemini -u normal -i utilities-terminal "Gemini done • $project" "Turn finished" >/dev/null 2>&1
    fi
    ;;
  *)
    if ! "$HOME/.local/bin/notipill" send --source gemini --kind info --title "Gemini · $project" --body "Unknown hook event: $event" >/dev/null 2>&1; then
      notify-send -a Gemini -u low -i utilities-terminal "Gemini" "Unknown hook event: $event" >/dev/null 2>&1
    fi
    ;;
esac

# Empty JSON object — no decision, no override
printf '{}'
